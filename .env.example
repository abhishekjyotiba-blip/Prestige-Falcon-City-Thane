# Lead API: disabled by default, and always disabled in production.
# Only enable for local testing. This writes personal data to a private local inbox;
# do not enable on a publicly accessible preview or treat it as a production CRM.
# NODE_ENV=development
# ENABLE_DEV_LEADS=1
# API_PORT=3001
# DEV_LEADS_FILE=server/data/leads.jsonl
# API_TARGET=http://127.0.0.1:3001 (Vite proxy; point at a local test API only)
# PRIVATE_LOCAL_PREVIEW=1 (binds Vite to 127.0.0.1 and enables only its local lead proxy)

# Public enquiry fields edit temporary drafts only. Submission is always disabled.
# VITE_LEAD_FORM_READY is obsolete; even true cannot enable production collection.
# Approving and connecting a production destination requires a separate implementation.
